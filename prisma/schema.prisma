generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Sender {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    Email[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

model Email {
  id             String      @id @default(uuid())
  tenantId       String
  senderId       String
  recipient      String
  subject        String
  textBody       String
  scheduledAt    DateTime
  status         EmailStatus @default(SCHEDULED)
  attempts       Int         @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sender         Sender      @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, scheduledAt])
  @@index([senderId, createdAt])
}

model SlackConnection {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  encryptedToken    String
  teamName          String?
  channelId         String?
  channelName       String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SlackOAuthState {
  state     String   @id
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

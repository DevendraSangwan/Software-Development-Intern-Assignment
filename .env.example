DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/email_scheduler?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Dashboard/API
TENANT_ID=demo
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# SMTP credentials from a generated Ethereal test account
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Worker load controls
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_JOB_ATTEMPTS=5

# Required for Slack OAuth and encrypted token storage
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
TOKEN_ENCRYPTION_KEY=
